# ==========================================
# Git Ignore Configuration
# ==========================================

# 1. Dependency directories
node_modules/
*/node_modules/
**/node_modules/

# 2. Environment and sensitive secret files
.env*
*.env*
backend/.env*
frontend/.env*
.history/
**/.history/

# 3. Production build outputs
dist/
build/
*/dist/
*/build/

# 4. Logs and cache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# 5. OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# 6. IDE / Editor directories
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 7. Archives
*.zip
*.tar.gz
